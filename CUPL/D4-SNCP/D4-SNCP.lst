 10:/* PAL16L8 */
 11:
 12:/*                                                PAL DESIGN SPECIFICATION */
 13:
 14:/* D4-SNCP        105657-001                               PAUL R. CULLEY 05/07/86 */
 15:
 16:/* Numeric Coproccessor error and busy logic  */
 17:
 18:/* Copyright 1986 Compaq Computer Houston, Texas */
 19:
 20:
 21:PIN 1 = !TIMCS ;
 22:PIN 2 = !XIOWC ;
 23:PIN 3 = XA0 ;
 24:PIN 4 = !ERROR ;
 25:PIN 5 = !BUSYIN ;
 26:PIN 6 = TIMO ;
 27:PIN 7 = !NCPIN ;
 28:PIN 8 = !NCPCS ;
 29:PIN 9 = !RESET ;
 30:PIN 11 = XA3 ;
 31:PIN 12 = RES287 ;
 32:PIN 13 = !TIM2CS ;
 33:PIN 14 = !TIM1CS ;
 34:PIN 15 = ONESHT ;
 35:PIN 16 = IRQ13 ;
 36:PIN 17 = NC02 ;
 37:PIN 18 = EN_ERR ;
 38:PIN 19 = !BUSYOUT ;/* The following equation is the positive true output of the equation: */
 39:
 40:
 41:
 42:/* RES287 = RESET + XIOWC * NCPCS * /XA3 * XA0  ; I/O write to F1h */
 43:   
 44:IRES287 =
 45:  !RESET  & !XIOWC /* NOT I/O WRITE */
 46:# !RESET  & !NCPCS /*  NOT port FX */
 47:# !RESET  &  XA3   /*  NOT address XXIXXXb */
 48:# !RESET  & !XA0;  /*  NOT address XXXXXOb */
 49:                  
 50:   
 51:BUSYOUT =
 52:  !RESET & NCPIN  & BUSYIN /*  coprocessor busy */
 53:# !RESET  & NCPIN  & ERROR  & EN_ERR & !TIMO /*  error before int ack */

