 54:# !RESET  & !NCPIN & NCPCS  & XA3  & XIOWC /*  When not installed and NCP accessed */
 55:# !RESET  & !NCPIN & ONESHT & !TIMO; /*  When not installed till timeout */
 56:
 57:
 58:/* The following equation is the positive true output of the equation: */
 59:/*  IRQ13 = ERROR* /BUSYIN* EN_ERR* NCPIN   ; Int when error and enabled */
 60:!IRQ13 =
 61:         !ERROR /*  No int if no error */
 62:       #  BUSYIN /*  or busy */
 63:       # !EN_ERR /*  or not enabled for err */
 64:       # !NCPIN; /*  No int if not installed */
 65:                                   
 66:   
 67:!EN_ERR =
 68:    !RESET & NCPIN & !EN_ERR  &  ERROR  /*  Hold disabled till ERROR goes away */
 69:  # !RESET & NCPIN & !EN_ERR  &  BUSYIN /*  Hold disabled till BUSY goes away */
 70:  #  XIOWC  & NCPCS & !XA3     & !XA0;   /*  Disable on write to port 0F0h */
 71:              
 72:   
 73:!ONESHT =
 74:    NCPIN & !IRQ13                      /*  One shot output when IRQ (installed) */
 75: # !NCPIN & !ONESHT  & !XIOWC           /*  Goes high on NCP access when not */
 76: # !NCPIN  & !ONESHT  & !XA3            /*      installed */
 77: # !NCPIN  & !ONESHT  & !NCPCS 
 78: # !NCPIN  &  TIMO                      /*  and stays high till timeout */
 79: #  RESET;                              /*  Low at reset time */
 80:                                    
 81:   
 82:TIM1CS = TIMCS  & !XA3;                 /*  Timer 1 at address 040h-047h, 050h-057h */
 83:             
 84:   
 85:TIM2CS = TIMCS  &  XA3;                 /*  Timer 2 at address 048h-04Fh, 058h-05Fh */
 86: 
 87:
 88:/*
 89:DESCRIPTION
 90:This PAL is used in the Magnum processor board to handle the error logic for
 91:the numeric coprocessor. It allows a greater measure of compatibility with
 92:the previous products. It sets up the system to generate an interrupt when 
 93:the error signal is recieved. It holds the interrupt until the service
 94:routine does a write to port F0h. It also holds busy out active until the 
 95:interrupt occurs or till the CPU times out from no activity. This is to
 96:prevent any other numeric processor instructions from being executed until 
 97:the error has been recognized. If the no activity timeout occurs, that means
 98:the CPU hung up on the 287 interface due to different design of the 386.
 99:
100:In this case, the interrupt will have been recieved by the 386.
101:In addition, the timer chip selects are broken out to the seperate selects by the PAL logic.
102:
103:*/
104:
105:



