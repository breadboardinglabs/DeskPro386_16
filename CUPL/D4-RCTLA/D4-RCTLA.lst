 10:/* PAL16R8 */
 11:
 12:/*                                               PAL DESIGN SPECIFICATION */
 13:
 14:/* D4-RCTLA 108352-001                                    PAUL R. CULLEY  09/13/86 */
 15:
 16:/* D4 PAGE RAM BOARD Control logic */
 17:
 18:/* Copyright Compaq Computer Houston, Texas 1986 */
 19:
 20:
 21:PIN 1 = CLK ;
 22:PIN 2 = !ADSM ;
 23:PIN 3 = !DMIO ;
 24:PIN 4 = D_C ;
 25:PIN 5 = W_R ;
 26:PIN 6 = !M32 ;
 27:PIN 7 = HLDA ;
 28:PIN 8 = !CLK16 ;
 29:PIN 9 = !HIT ;
 30:PIN 11 = !OE ;
 31:PIN 12 = !MRAS ;
 32:PIN 13 = !SWM ;
 33:PIN 14 = !NAM ;
 34:PIN 15 = !MCAS ;
 35:PIN 16 = !MRDY ;
 36:PIN 17 = !MWE ;
 37:PIN 18 = !MRD ;
 38:PIN 19 = !YY ;
 39:             
 40:             
 41:
 42: 
 43:SWM.D =
 44:  !HLDA & CLK16 & ADSM & !MRDY & !W_R & M32                                  /* CPU IDLE TO MEMORY */
 45:# !HLDA   & CLK16 & ADSM & !MRDY & D_C  & M32                                /* CPU IDLE TO MEMORY */
 46:# !HLDA   & CLK16 & YY & !MRAS   & !SWM                                      /* AFTER A MISS */
 47:# !CLK16 & SWM  & !MRAS                                                      /* CLK16 SYNC */
 48:# HLDA  & !ADSM  & D_C  & !MRAS                                              /* DMA */
 49:# HLDA  & !ADSM  & !D_C & MRAS  & YY                                         /* REFRESH START */
 50:# HLDA  & !ADSM  & !D_C & SWM  & DMIO                                        /* REFRESH HOLD */
 51:# HLDA  & !ADSM  & DMIO  & SWM & !MRAS;                                      /* REFRESH END */
 52:               
 53: 

