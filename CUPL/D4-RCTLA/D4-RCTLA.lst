 54:YY.D =
 55:  !HLDA & CLK16  & ADSM & MRDY & !W_R & M32 & !HIT                           /* CPU PIPE TO MEMORY MISS */
 56:# !HLDA & CLK16  & ADSM & MRDY & D_C  & M32 & !HIT                           /* CPU PIPE TO MEMORY MISS */
 57:# !HLDA & NAM         & MRAS                                                 /* OR WHEN LATCH NEEDS CLOSED */
 58:# !HLDA & !CLK16 & YY                                                        /* CLK16 SYNC */
 59:# HLDA  & D_C  & MCAS   & DMIO & !ADSM                                       /* DMA */
 60:# HLDA  & YY         & DMIO   & !ADSM                                        /* DMA,REFRESH HOLD TO END */
 61:# HLDA  & !D_C & MRAS   & DMIO & !ADSM & !SWM & CLK16;                       /* REFRESH */
 62:  
 63:
 64: 
 65:NAM.D =
 66:  !HLDA & CLK16  &  ADSM &  MRDY & !W_R  & M32 & HIT                         /* CPU PIPE TO MEMORY HIT */
 67:# !HLDA & CLK16  &  ADSM &  MRDY &  D_C  & M32 & HIT                         /* CPU PIPE TO MEMORY HIT */
 68:# !HLDA & CLK16  &  SWM  & !ADSM & !NAM                                      /* AFTER AN IDLE OR MISS */
 69:#        !CLK16  &  NAM                                                      /* CLK16 SYNC */
 70:#  HLDA          & !ADSM;                                                    /* DURING REFRESH AND DMA */
 71:                                  
 72:
 73: 
 74:MRDY.D =
 75:  !HLDA   & CLK16 & NAM & MRAS                                               /* AFTER NA WILL BE READY */
 76:# !HLDA  & !CLK16 & MRDY;                                                    /* CLK16 SYNC */
 77:                            
 78: 
 79:MRAS.D =
 80:  !HLDA & SWM &  !ADSM  & !NAM                                               /* OUT OF A MISS OR IDLE OPERATION */
 81:# !HLDA & MRAS & !MRDY                                                       /* TILL MRDY */
 82:# !HLDA & MRAS & !CLK16                                                      /*  AND TILL CLK16 UNLESS */
 83:# !HLDA & MRAS &  ADSM  & !W_R & M32  & HIT                                  /* CPU PIPE HIT */
 84:# !HLDA & MRAS &  ADSM  &  D_C  & M32  & HIT                                 /* CPU PIPE HIT */
 85:#  HLDA & DMIO & !ADSM  & !D_C & !SWM & CLK16                                /* REFRESH */
 86:#  HLDA & DMIO & !ADSM  & !D_C & !SWM & MRAS                                 /* REFRESH HOLD */
 87:#  HLDA & DMIO & !ADSM  &  D_C  & M32  & !YY;                                /* DMA */
 88:            
 89: 
 90:MCAS.D =
 91:  !HLDA  &  CLK16 & NAM  & MRD   & MRAS                                      /* AFTER NA WILL BE CAS FOR READ */
 92:# !HLDA  & !CLK16 & MCAS                                                     /* CLK16 SYNC */
 93:# !HLDA  & !CLK16 & MRDY & MWE                                               /* AFTER START OF MRDY IS WRITE CAS */
 94:#  HLDA  & !ADSM  & D_C  & DMIO  & MRAS & !SWM                               /* DMA START */
 95:#  HLDA  & !ADSM  & D_C  & DMIO  & MCAS & MRD;                               /* DMA READ HOLD TILL END */
 96:          
 97: 
 98:MWE.D =
 99:  !HLDA  & !CLK16 & NAM  & D_C   & W_R & M32 & MRAS                          /* CPU WRITE TO MEMORY */
100:# !HLDA  & !CLK16 & MWE                                                      /* CLK16 SYNC */
101:# !HLDA  &  CLK16 & MWE  & NAM 
102:# HLDA   & !W_R   & DMIO & !ADSM & M32 & !YY                                 /* DMA WRITE */
103:# HLDA   &  MWE   & DMIO & !ADSM;                                            /* DMA WRITE HOLD */
104:                     
105: 
106:MRD.D =
107:  !HLDA & !CLK16 & NAM  & !W_R & M32 & MRAS                                  /* CPU READ FROM MEMORY */

