 10:/* PAL16L8 */
 11:
 12:/*                                                PAL DESIGN SPECIFICATION */
 13:
 14:/* D4-SCPYD 108395-OO1                                     PAUL R. CULLEY 12/17/86 */
 15:
 16:/* Copy buffer control logic and DMA low address logic
 17:   Note that changes were required to LM16 to avoid Unstable Output errors in the simulation
 18:   !LM16 changed to registered with BALE as the clock and Pin 11 defined as oe output enable active low
 19:   !HLDA moved to pin 19   */
 20:
 21:/* Copyright 1986 COMPAQ COMPUTER Houston, Texas */
 22:
 23:
 24:/* PIN 1 = !M16 ; */
 25:PIN 1 = BALE ;
 26:PIN 2 = !IO16 ;
 27:PIN 3 = !MWTC ;
 28:PIN 4 = !MRDC ;
 29:PIN 5 = !IOWX ;
 30:PIN 6 = !IORC ;
 31:PIN 7 = !DAEN1 ;
 32:PIN 8 = AEN2 ;
 33:PIN 9 = !M16 ;
 34:/* PIN 9 = BALE ; */
 35:/* PIN 11 = !HLDA ; */
 36:PIN 11 =  oe ;
 37:PIN 12 = !DAEN2 ;
 38:PIN 13 = !COPYEN ;
 39:PIN 14 = !COPYHL ;
 40:PIN 15 = !DAEN ;
 41:PIN 16 = !BHE ;
 42:PIN 17 = XA0 ;
 43:PIN 18 = !LM16 ;
 44:PIN 19 = !HLDA ;
 45:               
 46:            
 47:
 48:  
 49:COPYEN =
 50:  !DAEN  & BHE     & XA0  & !LM16 & MWTC  /* CPU write MEM */
 51:# !DAEN  & BHE     & XA0  & !IO16 & IOWX  /* CPU write I/O */
 52:# !DAEN  & BHE     & XA0  & !LM16 & MRDC  /* CPU read MEM */
 53:# !DAEN  & BHE     & XA0  & !IO16 & IORC  /* CPU read I/O */

LISTING FOR LOGIC DESCRIPTION FILE: D4-SCPYD.pld                     Page 2

CUPL(WM): Universal Compiler for Programmable Logic
