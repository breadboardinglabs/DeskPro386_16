Created Thu May 07 16:44:11 2026

 54:#  DAEN1 & COPYHL  & XA0  &  LM16 & MRDC  /* DMA byte mem read high of 16 */
 55:#  DAEN1           & XA0  &  LM16 & IORC; /* DMA byte mem write high of 16 */
 56:            
 57:  
 58:COPYHL = 
 59:  !DAEN  & BHE  & XA0  & !LM16  & MWTC    /* mem write */
 60:# !DAEN  & BHE  & XA0  & !IO16  & IOWX    /* I/O write */
 61:#  DAEN1        & XA0  &  LM16  & MRDC    /* DMA byte mem read high of 16 */
 62:#  COPYHL  & COPYEN;                      /*  Short holdover for write */
 63:                      
 64:    
 65:DAEN =
 66:  DAEN1  & HLDA 
 67:# AEN2   & HLDA;                          /* If word type of DMA, enable out  */
 68: 
 69:        
 70:                                              
 71:XA0.OE = AEN2 & HLDA;
 72:     
 73:!XA0 = AEN2;                              /*  (Pin is low for word DMA) */
 74:
 75:/* If DMA, enable output */
 76:BHE.OE = DAEN ;
 77:   
 78:BHE =
 79:  XA0  & DAEN1                             /*  If byte type, is inverted XA0 */
 80:# AEN2;                                    /* If word type, is active */
 81:                           
 82:
 83:LM16.d = M16;                              /* use BALE to latch M16 to avoid unstable output error on LM16 in simulation */
 84:
 85:/* The Latch term below causes simulations to fail due to Unstable Outputs, converted to registered pin
 86:LM16 =
 87:  M16  &  BALE                             Enable M16 input 
 88:# LM16 & !BALE                             Latch term **** Doesn't work reliably!
 89:# LM16 &  M16;                             Deglitch term */
 90:                              
 91: 
 92:DAEN2 = AEN2  &  HLDA;                     /* TIGHTEN UP ON HLDA */
 93:                            
 94:
 95:/*
 96:DESCRIPTION
 97:This PAL implements the logic to enable the copy buffer (high to low halves 
 98:of the 16 bit bus). It also drives the A0 and BHE lines as appropriate during
 99:DMA.
100:Rev A changes the COPYHL enable during byte DMA operations to the high half of 
101:the bus. The timing is made earlier by changing to IORC from MWTC. 
102:Rev D changes the polarity of the AEN2 signal for logic reduction on the D3PE 
103:D4-PROCESSOR board (with 80387).
104:*/
105:
106:



