 10:/* PAL16L8 */
 11:
 12:/*                                                PAL DESIGN SPECIFICATION */
 13:
 14:/* D4-RM32   108053-001                                    PAUL R. CULLEY 04/02/86 */
 15:
 16:/* D4 PAGE RAM BOARD M32 decode logic Copyright Compaq Computer Houston, Texas 1986 */
 17:
 18:/*  */
 19:
 20:
 21:PIN 1 = A31 ;
 22:PIN 2 = A23 ;
 23:PIN 3 = A22 ;
 24:PIN 4 = A21 ;
 25:PIN 5 = A20 ;
 26:PIN 6 = A19 ;
 27:PIN 7 = A18 ;
 28:PIN 8 = A17 ;
 29:PIN 9 = FA20 ;
 30:PIN 11 = !2M ;
 31:PIN 12 = !M32A ;
 32:PIN 13 = !M32B ;
 33:PIN 14 = !ROM ;
 34:PIN 15 = !512K ;
 35:PIN 16 = !640K ;
 36:PIN 17 = !1M ;
 37:PIN 18 = !8M ;
 38:PIN 19 = !M32C ;
 39:
 40:M32A.OE = !A22&!A21 ;
 41:     
 42:M32A =
 43:  !A31 & !A23& !A22& !A21& !A20& !A19& !A18              /* 000000-03FFFF 256K */
 44:# !A31 & !A23& !A22& !A21& !A19& !A18& !FA20             /* 000000-03FFFF 256K */
 45:# !A31 & !A23& !A22& !A21& !A20& !A19&  A18&       512K  /* 040000-07FFFF 256K */
 46:# !A31 & !A23& !A22& !A21& !A20&  A19& !A18& !A17& 640K  /* 080000-09FFFF 128K */
 47:# !A31 & !A23& !A22& !A21& !A20&  A19&  A18&  A17& ROM   /* 0E0000-0FFFFF 128K */
 48:# !A31 & !A23& !A22& !A21&  A20&                   1M    /* 100000-1FFFFF 1M */
 49:# !A31 &  A23& !A22& !A21&                         8M;   /* 800000-9FFFFF 2M */
 50:                               
 51:
 52:M32B.OE = A22&!A21 ;
 53:     

