 10:/* PAL20R4 */
 11:
 12:/*                                                PAL DESIGN SPECIFICATION */
 13:
 14:/* D4-SADOD 108393-001                                     PAUL R. CULLEY 01/09/87 */
 15:
 16:/* Bus enable to address converter and cycle end logic */
 17:
 18:/* COPYRIGHT 1986, 1987 COMPAQ COMPUTER HOUSTON, TEXAS */
 19:
 20:
 21:PIN 1 = CALE ;
 22:PIN 2 = ALE ;
 23:PIN 3 = !BE3 ;
 24:PIN 4 = !BE2 ;
 25:PIN 5 = !BE1 ;
 26:PIN 6 = !BE0 ;
 27:PIN 7 = LM_IO ;
 28:PIN 8 = T00 ;
 29:PIN 9 = T10 ;
 30:PIN 10 = !LM16 ;
 31:PIN 11 = !IO16 ;
 32:PIN 13 = BHLDA ;
 33:PIN 14 = !CMD ;
 34:PIN 15 = !CLAST ;
 35:PIN 16 = !CLSTD ;
 36:PIN 17 = A1 ;
 37:PIN 18 = A0 ;
 38:PIN 19 = !BHE ;
 39:PIN 20 = !ALST ;
 40:PIN 21 = !CX16 ;
 41:PIN 22 = !DCMD ;
 42:PIN 23 = !RST ;/* The following 4 outputs are clocked by ALE, output only when /HLDA is true */
 43:
 44:                      
 45:                 
 46:
 47:  
 48:!A1.D =
 49:        !RST & !BE3 & !BE2 
 50:      # !RST & !A1 & !A0  & !CX16 & !CLAST 
 51:      # !RST & BE1 & CLAST;         
 52:
 53:A1.oe = !BHLDA;

