 54:  
 55:!A0.D =
 56:        !RST & BE0 & CLAST         
 57:      # !RST & BE2 & !BE1 & CLAST   
 58:      # !RST & BE2 & A0 & !CLAST    
 59:      # !RST & CX16 & !CLAST;       
 60:A0.oe = !BHLDA;
 61:
 62:  
 63:BHE.D =
 64:        !RST & !A0 & !CX16 & !CLAST 
 65:      # !RST & BE1 & CLAST         
 66:      # !RST & BE3; 
 67:BHE.oe = !BHLDA;
 68:
 69: 
 70:ALST.D =
 71:        !RST & !CX16  & !BE2   & !CLAST 
 72:      # !RST & !BE2   & !BE0   & CLAST  
 73:      # !RST & !BE3   & !BE1   & CLAST  
 74:      # !RST & !BE3   & A0     & !CLAST 
 75:      # !RST & !CX16  & A1     & !A0  & !CLAST 
 76:      # !RST & CX16   & !BE3   & !CLAST;        /* Cycle LAST PRESET input for internal F/F (Cleared by rising edge of ALE)  */
 77:ALST.oe = !BHLDA;                                /* This is pulsed only once to set F/F and generate the NAB* signal */
 78: 
 79:
 80: 
 81:CLSTD =
 82:         ALST  &  T00                            /* Active during the last cycle of set */
 83:      #  LM_IO  & LM16 & T00 & !BE2 
 84:      #  LM_IO  & LM16 & T00 & A1  
 85:      # !LM_IO & IO16 & T10 & !BE2 & !ALST 
 86:      # !LM_IO & IO16 & T10 & A1  & !ALST  
 87:      #  RST;                                    /* and during RESET */
 88:CLSTD.oe = 'b'1;                               
 89: 
 90:CLAST =
 91:         ALST   & T00                             /* Active during the last cycle of set */
 92:      #  LM_IO  & LM16 & T00 & !BE2 
 93:      #  LM_IO  & LM16 & T00 & A1  
 94:      # !LM_IO & IO16 & T10 & !BE2 & !ALST 
 95:      # !LM_IO & IO16 & T10 & A1 & !ALST   
 96:      #  RST                                      /* and during RESET */
 97:      #  CLAST  &  !ALE;                          /* HOLDS ACTIVE TILL ALE */
 98:CLAST.oe = 'b'1;                      
 99:  
100:CX16 = 
101:  !RST &  LM_IO &  T00 & LM16  /* CPU MEM OP */
102:# !RST & !LM_IO &  T10 & IO16  /* CPU I/O OP */                  
103:# !RST & !ALE          & CX16; /* CPU HOLD */
104:CX16.oe = 'b'1;            
105: 
106:DCMD = CMD; /*  DELAYED COMMAND */
107:DCMD.oe = 'b'1;                                 

