 54:Pin  9 = T00;
 55:Pin 10 = T01;
 56:Pin 11 = T10;
 57:Pin 13 = !OE;
 58:Pin 14 = T31;
 59:Pin 23 = !RST;
 60:
 61:/* Outputs Note GAL20V10 Pin 23 and 14 are also inputs. Only Pins 15-22 can be Outputs */
 62:
 63:Pin 15 = !BRDY;
 64:Pin 16 = !TS0;
 65:Pin 17 = !CMD;
 66:Pin 18 = !WDEN;
 67:Pin 19 = !T40;
 68:Pin 20 = !T41;
 69:Pin 21 = CK8;
 70:Pin 22 = !ALE;
 71:
 72:
 73:/* The following functions are clocked by CLK16* */
 74:
 75:TS0.d =
 76:    !RST & !CLAST &  T41 & !BWAIT                  /* START NEXT CYCLE WHEN DONE WITH */
 77:  # !RST & !CLAST & !CK8 &  LNOWS & CMD            /* PREV CYCLE AND MORE IN GROUP */ 
 78:  # !RST &  CLAST &  T41 & !BWAIT & MYCYC          /* START NEXT CYCLE WHEN DONE WITH */
 79:  # !RST &  CLAST & !CK8 &  LNOWS & CMD & MYCYC;  /* PREV CYCLE AND NEW CPU REQUEST IS PENDING */
 80:TS0.oe = OE;
 81:
 82:CMD.d =
 83:    !RST &  CMD & !LNOWS & !T41            /* HOLDS UNTIL ENDED BY END OF */
 84:  # !RST &  CMD & !LNOWS &  BWAIT          /* WAIT */
 85:  # !RST &  CMD &  CK8                     /* OR NOWS AND CK8 LOW */
 86:  # !RST & !CMD &  ALE & M16 & LMIO       /* STARTS AFTER ALE UNLESS */
 87:  # !RST & !CMD &  T00;                    /* CMDLY (THEN AFTER T00) */
 88:CMD.oe = OE;
 89:  
 90:WDEN.d =
 91:    !RST &  TS0                               /* STARTS WHEN ALE DOES AFTER TSO */
 92:  # !RST & !TS0 & !ALE & !CMD & !T00 & MYCYC  /* OR WHEN CPU SENDS NEW START REQUEST */
 93:  # !RST &  ALE                               /* CONTINUES THROUGH T00 */
 94:  # !RST &  T00                               /* AND T01 */
 95:  # !RST &  CMD;                              /* UNTIL AFTER CMD GOES AWAY */
 96:WDEN.oe = OE;
 97:  
 98:T41.d =
 99:    !RST &  T40                           /* STARTS WHEN T40 ENDS */
100:  # !RST &  T10 & CX16 & !LNOWS & CMD     /* OR WHEN T10 ENDS ON 1/0 CYCLE */
101:  # !RST &  T41 & BWAIT;                  /* AND HOLDS TILL WAIT IS GONE */
102:T41.oe = OE;
103:  
104:
105:T40.d =
106:    T01 & CX16 & !LNOWS & !RST            /* STARTS AFTER T01 IF 16 BIT */
107:  # T31 &        !LNOWS & !RST;            /* OR AFTER T31 OTHERWISE */

