108:T40.oe = OE;
109:  
110:!CK8.d =
111:    !RST & TS0                               /* SET TO LOW DURING ALE AFTER TS0 */
112:  # !RST & !TS0 & !ALE & !CMD & !T00 & MYCYC /* WHEN CPU SENDS NEW START REQUEST */
113:  # CK8;                                     /* OTHERWISE, DIVIDE BY TWO */
114:CK8.oe = OE;
115:  
116:BRDY.d =
117:    !RST & CLAST & T41 & !BWAIT              /* START NEXT CYCLE WHEN DONE */
118:  # !RST & CLAST & !CK8 & LNOWS & CMD;      /* WITH PREV CYCLE AND NO MORE IN GROUP */
119:BRDY.oe = OE;
120: 
121:ALE.d =
122:    !RST & TS0                                 /* ALE FOLLOWS TSO FOR INTERNAL LISE */
123:  # !RST & !TS0 & !ALE & !CMD & !T00 & MYCYC;  /* WHEN CPU SENDS NEW START REQUEST */
124:ALE.oe = OE;
125:  
126:/* FUNCTION TABLE
127:CLK16 /OE /RST /M16 LMIO /LNOWS /BWAIT /CLAST /CX16 /MYCYC TS0 ALE T00 
128:T01 T10 T31 T40 T41 /BRDY /CMD /WDEN CK8
129:;        / / /   / 
130:;C       L B C /    M                  /   / 
131:;L   /   L N W L C  Y                  B / W 
132:;K / R M M 0 A A X  C T A T T T T T T  R C D C
133:;1 O S 1 I W I S 1  Y S L 0 0 1 3 4 4  D M E K
134:;6 E T 6 O S T T 6  C 0 E 0 1 0 1 0 1  Y D N 8
135:;I I I I I I I I I  I O O I I I I O O  O O O O 
136:---------------------------------------------------~----------------------
137:*/
138:
139:
