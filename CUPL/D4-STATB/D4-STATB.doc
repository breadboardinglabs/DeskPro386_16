Designer        Dave Henry
Company         Breadboarding Labs
Assembly        None
Location        None

===============================================================================
                            Expanded Product Terms
===============================================================================

ALE.d  =>
    !RST & TS0
  # !ALE & !CMD & MYCYC & !RST & !T00 & !TS0

ALE.oe  =>
    OE

BRDY.d  =>
    !BWAIT & CLAST & !RST & T41
  # !CK8 & CLAST & CMD & LNOWS & !RST

BRDY.oe  =>
    OE

!CK8.d  =>
    !RST & TS0
  # !ALE & !CMD & MYCYC & !RST & !T00 & !TS0
  # CK8

CK8.oe  =>
    OE

CMD.d  =>
    CMD & !LNOWS & !RST & !T41
  # BWAIT & CMD & !LNOWS & !RST
  # CK8 & CMD & !RST
  # ALE & !CMD & LMIO & M16 & !RST
  # !CMD & !RST & T00

CMD.oe  =>
    OE

T40.d  =>
    CX16 & !LNOWS & !RST & T01
  # !LNOWS & !RST & T31

T40.oe  =>
    OE

T41.d  =>
    !RST & T40
  # CMD & CX16 & !LNOWS & !RST & T10
  # BWAIT & !RST & T41

T41.oe  =>
    OE

TS0.d  =>
    !BWAIT & !CLAST & !RST & T41
  # !CK8 & !CLAST & CMD & LNOWS & !RST
  # !BWAIT & CLAST & MYCYC & !RST & T41
  # !CK8 & CLAST & CMD & LNOWS & MYCYC & !RST

TS0.oe  =>
    OE

WDEN.d  =>
    !RST & TS0
  # !ALE & !CMD & MYCYC & !RST & !T00 & !TS0
  # ALE & !RST
  # !RST & T00
  # CMD & !RST

WDEN.oe  =>
    OE

RST.oe  =>
    0 

T31.oe  =>
    0 


