 54:
 55:B1EN.OE = !TST ;
 56:   
 57:B1EN =
 58:  !A1 & BHE & MWTC & !WDEN         /* OTHER WRITE TO LOCAL MEM */
 59:# !A1 & BHE & MRDC & !WDEN & M32   /* OTHER READ FROM LOCAL MEM */
 60:# !A1 & BHE & LD_C & LW_R & WDEN;  /* CPU WRITE TO BUS */
 61:    
 62:
 63:B2EN.OE = !TST ;
 64:   
 65:B2EN =
 66:  A1 & !A0 & MWTC & !WDEN          /* OTHER WRITE TO LOCAL MEM */
 67:# A1 & !A0 & MRDC & !WDEN & M32    /* OTHER READ FROM LOCAL MEM */
 68:# A1 & !A0 & LD_C &  LW_R & WDEN;  /* CPU WRITE TO BUS */
 69:                    
 70:
 71:B3EN.OE = !TST ;
 72:   
 73:B3EN =
 74:  A1 & BHE & MWTC & !WDEN          /* OTHER WRITE TO LOCAL MEM */
 75:# A1 & BHE & MRDC & !WDEN & M32    /* OTHER READ FROM LOCAL MEM */
 76:# A1 & BHE & LD_C & LW_R  & WDEN;  /* CPU WRITE TO BUS */
 77:                    
 78:
 79:INTA.OE = !TST ;
 80:   
 81:INTA =
 82:   CMD & !LM_IO & !LW_R & !LD_C;   /* CPU INTERRUPT ACK */
 83:
 84:/*
 85:DESCRIPTION
 86:This PAL developes the control signal to enable the data buffers on the system
 87:board.
 88:Rev A ensures turnon of the buffer enables for mem write after the direction 
 89:is active by leaving the buffer turned around during the entire write cycle.
 90:Rev D is for use with D3PE D4-processor board (with 387).
 91:*/
 92:
