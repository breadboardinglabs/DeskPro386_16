 10:/* PAL16L8 */
 11:
 12:/*                                                PAL DESIGN SPECIFICATION */
 13:
 14:/* D4-SDEND 109390-001                                     PAUL R. CULLEY 12/09/80 */
 15:
 16:/* DataBuffer enable logic  */
 17:
 18:/* Copyright COMPAQ COMPUTER Houston, Texas 1986 */
 19:
 20:
 21:PIN 1 = A1 ;
 22:PIN 2 = A0 ;
 23:PIN 3 = !BHE ;
 24:PIN 4 = !CMD ;
 25:PIN 5 = !M32 ;
 26:PIN 6 = !WDEN ;
 27:PIN 7 = LW_R ;
 28:PIN 8 = LD_C ;
 29:PIN 9 = LM_IO ;
 30:PIN 11 = !TST ;
 31:PIN 12 = !BDIRRD ;
 32:PIN 13 = !B0EN ;
 33:PIN 14 = !B1EN ;
 34:PIN 15 = !B2EN ;
 35:PIN 16 = !INTA ;
 36:PIN 17 = !MWTC ;
 37:PIN 18 = !MRDC ;
 38:PIN 19 = !B3EN ;
 39:
 40:                        
 41:            
 42:BDIRRD.OE = !TST ;
 43:   
 44:BDIRRD = !MRDC & !WDEN;            /* OTHER WRITE TO LOCAL MEM */
 45:                
 46:
 47:B0EN.OE = !TST ;
 48:   
 49:B0EN =
 50:  !A1 & !A0 & MWTC & !WDEN         /* OTHER WRITE TO LOCAL MEM */
 51:# !A1 & !A0 & MRDC & !WDEN & M32   /* OTHER READ FROM LOCAL MEM */
 52:# !A1 & !A0 & LD_C & LW_R & WDEN;  /* CPU WRITE TO BUS */
 53:    

