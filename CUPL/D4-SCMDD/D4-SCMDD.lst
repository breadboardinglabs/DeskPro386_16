109:;  L    H    L   H    ; CPU HALT OR SHUTDOWN
110:;  L    H    H   L    ; CPU MEMORY DATA READ
111:;  L    H    H   H    ; CPU MEMORY DATA WRITE
112:;  H    L    L   L    ; NON CPU REFRESH WRITE (SHOULD NOT HAPPEN)
113:;  H    L    L   H    ; NON CPU REFRESH READ
114:;  H    L    H   L    ; NON CPU MEMORY WRITE
115:;  H    L    H   H    ; NON CPU MEMORY READ
116:;  H    H    L   X    ; NON CPU REFRESH CYCLE (BEFORE OR AFTER)
117:;  H    H    H   X    ; NON CPU NO CYCLE PRESENT
