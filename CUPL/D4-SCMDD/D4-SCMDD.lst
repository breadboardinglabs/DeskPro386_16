 10:/* PAL16L8 */
 11:
 12:/*                                                PAL DESIGN SPECIFICATION */
 13:
 14:/* D4-SCMDD  108394-001                                 PAUL R. CULLEY    01/09/87 */
 15:
 16:/* Command encode and decode logic */
 17:
 18:/* Copyright 1986,1987 COMPAQ COMPUTER Houston, Texas */
 19:
 20:
 21:PIN 1 = !CMD ;
 22:PIN 2 = !DCMD ;
 23:PIN 3 = LM_IO ;
 24:PIN 4 = LW_R ;
 25:PIN 5 = LD_C ;
 26:PIN 6 = !RFSH ;
 27:PIN 7 = !BHLDA ;
 28:PIN 8 = NCI1 ;
 29:PIN 9 = NCI2 ;
 30:PIN 11 = !OE ;
 31:PIN 12 = !IOWC ;
 32:PIN 13 = !MRDC ;
 33:PIN 14 = !MWTC ;
 34:PIN 15 = !IORC ;
 35:PIN 16 =  MHLDA ;
 36:PIN 17 =  M_IO ;
 37:PIN 18 =  D_C ;
 38:PIN 19 =  W_R ;
 39:
 40:
 41:
 42:/*  MRDC.oe = OE ; MRDC will be an input when .oe=0 SI file needs 1/0 */
 43:MRDC.oe = !BHLDA&OE ;
 44:    
 45:MRDC =
 46:  CMD & LM_IO  & !LW_R         /*  PROCESSOR MEMORY READ */
 47:# DCMD  & MRDC;                /*  SHORT READ HOLD */
 48:                   
 49:
 50:/* MWTC.oe = OE ; MWTC will be an input when .oe=0 SI file needs 1/0 */
 51:MWTC.oe = !BHLDA&OE ; 
 52:    
 53:MWTC =

