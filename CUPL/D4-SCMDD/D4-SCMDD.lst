 54:  CMD & LM_IO  & LW_R  & LD_C; /* PROCESSOR MEMORY WRITE */
 55:     
 56:
 57:IORC.oe = !BHLDA&OE ;
 58:    
 59:IORC =
 60:  CMD & !LM_IO & !LW_R  & LD_C /* PROCESSOR I/O READ */
 61:# DCMD  &  IORC;               /* SHORT READ HOLD */
 62:                   
 63:
 64:IOWC.oe = !BHLDA&OE ;
 65:    
 66:IOWC =
 67:  CMD & !LM_IO & LW_R  & LD_C; /* PROCESSOR I/O WRITE */
 68:    
 69:
 70:M_IO.oe = BHLDA&OE ;
 71:    
 72:!M_IO =
 73:  MWTC  # MRDC;                /* NON CPU MEMORV OPERATION */
 74:  
 75:D_C.oe = BHLDA&OE ;
 76:     
 77:D_C = !RFSH;                   /* NON CPU REFRESH OPERATION */
 78:         
 79:W_R.oe = BHLDA&OE ;
 80:    
 81:W_R = !MWTC;                   /* NON CPU WRITE OPERATION */
 82:          
 83: 
 84:!MHLDA =
 85:  !BHLDA                      /* SAME A BHLDA EXCEPT */
 86:# !MHLDA  & !M_IO;            /* WHEN GOING HOLD, WAIT FOR M_IO TO GO HIGH */
 87:
 88:
 89:/*
 90:DESCRIPTION
 91:This PAL decodes the processor status lines and generates the normal command
 92:output signals. These signals are floated during non processor commands.
 93:
 94:In addition, the PAL decodes the non processor operations and feeds them to 
 95:the cpu status bus during HOLDA.
 96:
 97:Rev A of the PAL adds the input DCMD* and OE*. DCMD* is used to provide a 
 98:short data hold time for read operations by extending MRDC and IORC by one 
 99:PAL delay (10 ns). OE* is added to disable all outputs for testing.
100:Rev D of the PAL removes INTA and adds MHLDA for use in the DP3E D4-processor
101:board (with 387).
102:
103:; HLDA M_IO D_C W_R
104:;  L    L    L   L    ; CPU INTERRUPT ACK
105:;  L    L    L   H    ; CPU NEVER PRODUCES THIS CODE
106:;  L    L    H   L    ; CPU I/O READ
107:;  L    L    H   H    ; CPU I/O WRITE

