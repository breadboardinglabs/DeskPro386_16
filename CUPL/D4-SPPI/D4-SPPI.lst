 54:  
 55:CIORD  = !XA9   & !XA8  &  XIORC                /*  0-FFH */
 56:       # INTA;                                  /*  or Interrupt ack */
 57: 
 58:!CMOSAWR = !NMICLK  & !RESCMOS                  /*  Inverted NMICLK */
 59:         # !XIOWC   & !RESCMOS;                 /*  CMOS address write (70h) */
 60:                  
 61:
 62:
 63:/*
 64:DESCRIPTION
 65:This PAL is used in the D4 (386) processor board to decode addresses within the
 66:range 60h to 7Fh for I/O. It also generates the signal that controls the
 67:direction of the I/O data buffer XD<7..0>.
 68:
 69:*/
