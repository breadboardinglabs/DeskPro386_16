 10:/* PAL16L8 */
 11:
 12:/*                                                PAL DESIGN SPECIFICATION */
 13:
 14:/* D4-SPPI 105659-001                                   PAUL R. CULLEY    12/10/85 */
 15:
 16:/* Peripheral interface decode logic */
 17:
 18:/* Copyright Compaq Computer Houston, Texas */
 19:
 20:
 21:PIN 1 = XA4 ;
 22:PIN 2 = !PPICS ;
 23:PIN 3 = !XIORC ;
 24:PIN 4 = XA3 ;
 25:PIN 5 = XA9 ;
 26:PIN 6 = XA0 ;
 27:PIN 7 = XA8 ;
 28:PIN 8 = !XIOWC ;
 29:PIN 9 = !INTA ;
 30:PIN 11 = RESCMOS ;
 31:PIN 12 = !CMOSWR ;
 32:PIN 13 = !NMICLK ;
 33:PIN 14 = !PBWR ;
 34:PIN 15 = !CMOSRD ;
 35:PIN 16 = !KEYCS ;
 36:PIN 17 = !CIORD ;
 37:PIN 18 = !PBRD ;
 38:PIN 19 = CMOSAWR ;
 39:                              
 40:           
 41:
 42: 
 43:NMICLK = PPICS  &  XA4  & !XA3  & !XA0 & XIOWC; /*  NMI register write (70h) */
 44: 
 45:CMOSRD = PPICS  &  XA4  & !XA3  &  XA0 & XIORC; /*  CMOS data read (71h) */
 46: 
 47:CMOSWR = PPICS  &  XA4  & !XA3  &  XA0 & XIOWC; /*  CMOS data write (71h) */
 48:  
 49:KEYCS  = PPICS  & !XA4  & !XA3  & !XA0;         /*  8042 (60h, 64h) */
 50:   
 51:PBWR   = PPICS  & !XA4  & !XA3  &  XA0 & XIOWC; /*  Port B write (61h) */
 52:   
 53:PBRD   = PPICS  & !XA4  & !XA3  &  XA0 & XIORC; /*  Port B read (61h) */

