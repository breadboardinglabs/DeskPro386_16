 54:# !CLSTD  & MYCYC;                         /*  HOLD TILL NAB */
 55:                     
 56:NAB.D = CLSTD;                             /*  NEXT ADDRESS BUS */
 57:                         
 58:
 59:LNCP =
 60:  MYCYC &  BALE & PA31 & !M_IO             /*  NUMERIC COPROCESSOR OP */
 61:# LNCP  & !BALE                             /*  HOLD TILL NEXT ALE OR HOLD */
 62:# MYCYC &  PA31 & !M_IO & LNCP;             /*  DEGLITCH */
 63:           
 64:
 65:/*
 66:DESCRIPTION
 67:Rev D of this PAL is for the upgraded D3PE D4-processor board (with 387) and
 68:is a new design.
 69:This PAL contains the equations for the signal MYCYC (BUS state machine cycle),
 70:SHTD <decoded shutdown status), LNCP (numeric processor access status), and
 71:LOE (latch output enable). It also is the F/F for the NAB signal.
 72:*/
 73:
