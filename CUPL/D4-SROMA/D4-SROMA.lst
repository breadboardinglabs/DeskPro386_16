 10:/* PAL16L8 */
 11:
 12:/*                                                PAL DESIGN SPECIFICATION */
 13:
 14:/* D4-SROMA 108135-001                                  PAUL R. CULLEY    06/26/86 */
 15:
 16:/* System ROM decode logic */
 17:
 18:/* Copyright 1986 Compaq Computer Houston, Texas */
 19:
 20:
 21:PIN 1 = BALE ;
 22:PIN 2 = LA23 ;
 23:PIN 3 = LA22 ;
 24:PIN 4 = LA21 ;
 25:PIN 5 = LA20 ;
 26:PIN 6 = LA19 ;
 27:PIN 7 = LA18 ;
 28:PIN 8 = LA17 ;
 29:PIN 9 = SA16 ;
 30:PIN 11 = !MRDC ;
 31:PIN 12 = !ROMIOE ;
 32:PIN 13 = !RFSH ;
 33:PIN 14 = !M32 ;
 34:PIN 15 = !M16E ;
 35:PIN 16 = !ROM ;
 36:PIN 17 = !ROMEN ;
 37:PIN 18 = !LOWEN ;
 38:PIN 19 = !ROM20E ;
 39:                      
 40:         
 41:
 42: 
 43:M16E =
 44:  !LA23 & !LA22 & !LA21 & !LA20 & LA19 & LA18 & LA17        /* 00E0000h-00FFFFFh */
 45: # LA23 &  LA22 &  LA21 &  LA20 & LA19 & LA18 & LA17        /* 0FE0000h-0FFFFFFh */
 46: # M32;  
 47:     
 48:  
 49:ROM =
 50:  !LA23 & !LA22 & !LA21 & !LA20 & LA19 & LA18 & LA17 & BALE /* 00E0000h-00FFFFFh */
 51:#  LA23 &  LA22 &  LA21 &  LA20 & LA19 & LA18 & LA17 & BALE /* 0FE0000h-0FFFFFFh */
 52:# !LA23 & !LA22 & !LA21 & !LA20 & LA19 & LA18 & LA17 & ROM  /* DEGLITCH */
 53:#  LA23 &  LA22 &  LA21 &  LA20 & LA19 & LA18 & LA17 & ROM  /* DEGLITCH */

