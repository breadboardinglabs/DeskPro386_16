 54:# !BALE &  ROM;                                             /* LATCH TERM */
 55:                                       
 56: 
 57:ROMIOE =
 58:  ROM  & SA16  & MRDC;                                      /* 00F0000h-00FFFFFh  */
 59:                                                            /* 0FF0000h-0FFFFFFh */
 60:                                                                                     
 61: 
 62:ROM20E = ROM  & !SA16  & MRDC;                              /* 00E0000h-00EFFFFh  */
 63:                                                            /* 0FE0000h-0FEFFFFh */
 64:  
 65:ROMEN =
 66:  ROM  & MRDC;                                              /* BUFFER ENABLE */
 67:                                     
 68: 
 69:LOWEN =
 70:  !LA23 & !LA22 & !LA21 & !LA20 & BALE                      /* BOTTOM ONE MEGABYTE AND BALE */
 71:# !LA23 & !LA22 & !LA21 & !LA20 & LOWEN                     /* DEGLITCH TERM */
 72:# !BALE & LOWEN                                             /* LATCH TERM */
 73:# RFSH;                                                     /* AND REFRESH */
 74:                                                  
 75:
 76:
 77:/*
 78:DESCRIPTION
 79:This PAL is used in the D4 (386) processor board to decode ROM addresses
 80:within the two ranges 0FE0000h-0FFFFFFh and 00E0000h-00FFFFFh. It also
 81:generates the signal that controls the ROM data buffer RD<15..0> and the
 82:signal M16 (memory is 16 bits) during ROM accesses.
 83:The signal LOWEN* is generated by this PAL to indicate when the low one
 84:megabyte of the system is being accessed.
 85:
 86:*/
 87:
 88:



Jedec Fuse Checksum       (54b2)
Jedec Transmit Checksum   (1adf)
