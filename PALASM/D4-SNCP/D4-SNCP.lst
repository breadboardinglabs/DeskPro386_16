108: #  RESET;                              /*  Low at reset time */
109:                                    
110:   
111:TIM1CS = TIMCS  & !XA3;                 /*  Timer 1 at address 040h-047h, 050h-057h */
112:             
113:   
114:TIM2CS = TIMCS  &  XA3;                 /*  Timer 2 at address 048h-04Fh, 058h-05Fh */
