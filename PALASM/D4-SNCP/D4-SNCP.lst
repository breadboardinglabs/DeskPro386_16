 54:PIN 5 = !BUSYIN ;
 55:PIN 6 = TIMO ;
 56:PIN 7 = !NCPIN ;
 57:PIN 8 = !NCPCS ;
 58:PIN 9 = !RESET ;
 59:PIN 11 = XA3 ;
 60:PIN 12 = RES287 ;
 61:PIN 13 = !TIM2CS ;
 62:PIN 14 = !TIM1CS ;
 63:PIN 15 = ONESHT ;
 64:PIN 16 = IRQ13 ;
 65:PIN 17 = NC02 ;
 66:PIN 18 = EN_ERR ;
 67:PIN 19 = !BUSYOUT ;/* The following equation is the positive true output of the equation: */
 68:
 69:
 70:
 71:/* RES287 = RESET + XIOWC * NCPCS * /XA3 * XA0  ; I/O write to F1h */
 72:   
 73:!RES287 =
 74:  !RESET  & !XIOWC /* NOT I/O WRITE */
 75:# !RESET  & !NCPCS /*  NOT port FX */
 76:# !RESET  &  XA3   /*  NOT address XXIXXXb */
 77:# !RESET  & !XA0;  /*  NOT address XXXXXOb */
 78:                  
 79:   
 80:BUSYOUT =
 81:  !RESET & NCPIN  & BUSYIN /*  coprocessor busy */
 82:# !RESET  & NCPIN  & ERROR  & EN_ERR & !TIMO /*  error before int ack */
 83:# !RESET  & !NCPIN & NCPCS  & XA3  & XIOWC /*  When not installed and NCP accessed */
 84:# !RESET  & !NCPIN & ONESHT & !TIMO; /*  When not installed till timeout */
 85:
 86:
 87:/* The following equation is the positive true output of the equation: */
 88:/*  IRQ13 = ERROR* /BUSYIN* EN_ERR* NCPIN   ; Int when error and enabled */
 89:!IRQ13 =
 90:         !ERROR /*  No int if no error */
 91:       #  BUSYIN /*  or busy */
 92:       # !EN_ERR /*  or not enabled for err */
 93:       # !NCPIN; /*  No int if not installed */
 94:                                   
 95:   
 96:!EN_ERR =
 97:    !RESET & NCPIN & !EN_ERR  &  ERROR  /*  Hold disabled till ERROR goes away */
 98:  # !RESET & NCPIN & !EN_ERR  &  BUSYIN /*  Hold disabled till BUSY goes away */
 99:  #  XIOWC  & NCPCS & !XA3     & !XA0;   /*  Disable on write to port 0F0h */
100:              
101:   
102:!ONESHT =
103:    NCPIN & !IRQ13                      /*  One shot output when IRQ (installed) */
104: # !NCPIN & !ONESHT  & !XIOWC           /*  Goes high on NCP access when not */
105: # !NCPIN  & !ONESHT  & !XA3            /*      installed */
106: # !NCPIN  & !ONESHT  & !NCPCS 
107: # !NCPIN  &  TIMO                      /*  and stays high till timeout */

