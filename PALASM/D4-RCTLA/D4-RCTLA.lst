Created Sat May 16 15:50:51 2026

 54:PIN 15 = !MCAS ;
 55:PIN 16 = !MRDY ;
 56:PIN 17 = !MWE ;
 57:PIN 18 = !MRD ;
 58:PIN 19 = !YY ;
 59:             
 60:             
 61:
 62: 
 63:SWM.D =
 64:  !HLDA & CLK16 & ADSM & !MRDY & !W_R & M32                                  /* CPU IDLE TO MEMORY */
 65:# !HLDA   & CLK16 & ADSM & !MRDY & D_C  & M32                                /* CPU IDLE TO MEMORY */
 66:# !HLDA   & CLK16 & YY & !MRAS   & !SWM                                      /* AFTER A MISS */
 67:# !CLK16 & SWM  & !MRAS                                                      /* CLK16 SYNC */
 68:# HLDA  & !ADSM  & D_C  & !MRAS                                              /* DMA */
 69:# HLDA  & !ADSM  & !D_C & MRAS  & YY                                         /* REFRESH START */
 70:# HLDA  & !ADSM  & !D_C & SWM  & DMIO                                        /* REFRESH HOLD */
 71:# HLDA  & !ADSM  & DMIO  & SWM & !MRAS;                                      /* REFRESH END */
 72:               
 73: 
 74:YY.D =
 75:  !HLDA & CLK16  & ADSM & MRDY & !W_R & M32 & !HIT                           /* CPU PIPE TO MEMORY MISS */
 76:# !HLDA & CLK16  & ADSM & MRDY & D_C  & M32 & !HIT                           /* CPU PIPE TO MEMORY MISS */
 77:# !HLDA & NAM         & MRAS                                                 /* OR WHEN LATCH NEEDS CLOSED */
 78:# !HLDA & !CLK16 & YY                                                        /* CLK16 SYNC */
 79:# HLDA  & D_C  & MCAS   & DMIO & !ADSM                                       /* DMA */
 80:# HLDA  & YY         & DMIO   & !ADSM                                        /* DMA,REFRESH HOLD TO END */
 81:# HLDA  & !D_C & MRAS   & DMIO & !ADSM & !SWM & CLK16;                       /* REFRESH */
 82:  
 83:
 84: 
 85:NAM.D =
 86:  !HLDA & CLK16  &  ADSM &  MRDY & !W_R  & M32 & HIT                         /* CPU PIPE TO MEMORY HIT */
 87:# !HLDA & CLK16  &  ADSM &  MRDY &  D_C  & M32 & HIT                         /* CPU PIPE TO MEMORY HIT */
 88:# !HLDA & CLK16  &  SWM  & !ADSM & !NAM                                      /* AFTER AN IDLE OR MISS */
 89:#        !CLK16  &  NAM                                                      /* CLK16 SYNC */
 90:#  HLDA          & !ADSM;                                                    /* DURING REFRESH AND DMA */
 91:                                  
 92:
 93: 
 94:MRDY.D =
 95:  !HLDA   & CLK16 & NAM & MRAS                                               /* AFTER NA WILL BE READY */
 96:# !HLDA  & !CLK16 & MRDY;                                                    /* CLK16 SYNC */
 97:                            
 98: 
 99:MRAS.D =
100:  !HLDA & SWM &  !ADSM  & !NAM                                               /* OUT OF A MISS OR IDLE OPERATION */
101:# !HLDA & MRAS & !MRDY                                                       /* TILL MRDY */
102:# !HLDA & MRAS & !CLK16                                                      /*  AND TILL CLK16 UNLESS */
103:# !HLDA & MRAS &  ADSM  & !W_R & M32  & HIT                                  /* CPU PIPE HIT */
104:# !HLDA & MRAS &  ADSM  &  D_C  & M32  & HIT                                 /* CPU PIPE HIT */
105:#  HLDA & DMIO & !ADSM  & !D_C & !SWM & CLK16                                /* REFRESH */
106:#  HLDA & DMIO & !ADSM  & !D_C & !SWM & MRAS                                 /* REFRESH HOLD */
107:#  HLDA & DMIO & !ADSM  &  D_C  & M32  & !YY;                                /* DMA */

