108:            
109: 
110:MCAS.D =
111:  !HLDA  &  CLK16 & NAM  & MRD   & MRAS                                      /* AFTER NA WILL BE CAS FOR READ */
112:# !HLDA  & !CLK16 & MCAS                                                     /* CLK16 SYNC */
113:# !HLDA  & !CLK16 & MRDY & MWE                                               /* AFTER START OF MRDY IS WRITE CAS */
114:#  HLDA  & !ADSM  & D_C  & DMIO  & MRAS & !SWM                               /* DMA START */
115:#  HLDA  & !ADSM  & D_C  & DMIO  & MCAS & MRD;                               /* DMA READ HOLD TILL END */
116:          
117: 
118:MWE.D =
119:  !HLDA  & !CLK16 & NAM  & D_C   & W_R & M32 & MRAS                          /* CPU WRITE TO MEMORY */
120:# !HLDA  & !CLK16 & MWE                                                      /* CLK16 SYNC */
121:# !HLDA  &  CLK16 & MWE  & NAM 
122:# HLDA   & !W_R   & DMIO & !ADSM & M32 & !YY                                 /* DMA WRITE */
123:# HLDA   &  MWE   & DMIO & !ADSM;                                            /* DMA WRITE HOLD */
124:                     
125: 
126:MRD.D =
127:  !HLDA & !CLK16 & NAM  & !W_R & M32 & MRAS                                  /* CPU READ FROM MEMORY */
128:# !HLDA & !CLK16 & MRD                                                       /* CLK16 SYNC */
129:# !HLDA &  CLK16 & MRD  &  NAM 
130:#  HLDA &  W_R   & DMIO &  D_C & !ADSM & M32 & MRAS                          /* DMA READ (NOT REFRESH) */
131:#  HLDA &  MRD   & DMIO & !ADSM;                                             /* DMA READ HOLD */
132:                     
