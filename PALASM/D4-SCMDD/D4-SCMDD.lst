108:IOWC.oe = !BHLDA&OE ;
109:    
110:IOWC =
111:  CMD & !LM_IO & LW_R  & LD_C; /* PROCESSOR I/O WRITE */
112:    
113:
114:M_IO.oe = BHLDA&OE ;
115:    
116:!M_IO =
117:  MWTC  # MRDC;                /* NON CPU MEMORV OPERATION */
118:  
119:D_C.oe = BHLDA&OE ;
120:     
121:D_C = !RFSH;                   /* NON CPU REFRESH OPERATION */
122:         
123:W_R.oe = BHLDA&OE ;
124:    
125:W_R = !MWTC;                   /* NON CPU WRITE OPERATION */
126:          
127: 
128:!MHLDA =
129:  !BHLDA                      /* SAME A BHLDA EXCEPT */
130:# !MHLDA  & !M_IO;            /* WHEN GOING HOLD, WAIT FOR M_IO TO GO HIGH */
131:
132:
133:
134:



