$TRACE 0;
/*
               / 
   /   L     / B   / / / / M
   D / M L L R H   M M I I H M
   C C - D W F L   R W O O L - D W
 O M M I - - S D   D T R W D I - -
 E D D O C R H A   C C C C A O C R */
 0 1 0 0 0 0 0 1   H H H H L Z Z Z /*01  INTA */
