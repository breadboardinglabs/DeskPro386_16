===============================================================================
                            Expanded Product Terms
===============================================================================

D_C =>
    !RFSH

D_C.oe  =>
    BHLDA & OE

IORC =>
    CMD & LD_C & !LM_IO & !LW_R
  # DCMD & IORC

IORC.oe  =>
    !BHLDA & OE

IOWC =>
    CMD & LD_C & !LM_IO & LW_R

IOWC.oe  =>
    !BHLDA & OE

!MHLDA =>
    !BHLDA
  # !MHLDA & !M_IO

MRDC =>
    CMD & LM_IO & !LW_R
  # DCMD & MRDC

MRDC.oe  =>
    !BHLDA & OE

MWTC =>
    CMD & LD_C & LM_IO & LW_R

MWTC.oe  =>
    !BHLDA & OE

!M_IO =>
    MWTC
  # MRDC

M_IO.oe  =>
    BHLDA & OE

W_R =>
    !MWTC

W_R.oe  =>
    BHLDA & OE

MHLDA.oe  =>
    1 


