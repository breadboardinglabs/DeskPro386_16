  # LA17 & LA18 & LA19 & LA20 & LA21 & LA22 & LA23 & ROM
  # !BALE & ROM

ROM1OE =>
    MRDC & ROM & SA16

ROM2OE =>
    MRDC & ROM & !SA16

ROMEN =>
    MRDC & ROM

