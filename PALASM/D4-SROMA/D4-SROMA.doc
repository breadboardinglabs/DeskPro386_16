  # RFSH

M16E =>
    LA17 & LA18 & LA19 & !LA20 & !LA21 & !LA22 & !LA23
  # LA17 & LA18 & LA19 & LA20 & LA21 & LA22 & LA23
  # M32

ROM =>
    BALE & LA17 & LA18 & LA19 & !LA20 & !LA21 & !LA22 & !LA23
  # BALE & LA17 & LA18 & LA19 & LA20 & LA21 & LA22 & LA23
