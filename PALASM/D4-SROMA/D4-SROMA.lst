  1:Name            D4-SROMA System ROM decode logic;
  2:PartNo          108135-001;
  3:Revision        01;
  4:Date            16/5/26;
  5:Designer        Dave Henry;
  6:Company         Breadboarding Labs;
  7:Location        None;
  8:Assembly        None;
  9:Device          g16v8;
 10:
 11:/* 16/05/2026 V1 Initial version converted from PALASM format in COMPAQ design doc         */
 12:/*                                                                                         */
 13:/*******************************************************************************************/
 14:/*                                                                                         */
 15:/*******************************************************************************************/
 16:/*
 17:DESCRIPTION
 18:This PAL is used in the D4 (386) processor board to decode ROM addresses
 19:within the two ranges 0FE0000h-0FFFFFFh and 00E0000h-00FFFFFh. It also
 20:generates the signal that controls the ROM data buffer RD<15..0> and the
 21:signal M16 (memory is 16 bits) during ROM accesses.
 22:The signal LOWEN* is generated by this PAL to indicate when the low one
 23:megabyte of the system is being accessed.
 24:
 25:*/
 26:/* Pin Map 
 27:                               ______________
 28:                              |   D4-SROMA   |
 29:                     BALE x---|1           20|---x Vcc                      
 30:                     LA23 x---|2           19|---x !ROM20E                  
 31:                     LA22 x---|3           18|---x !LOWEN                   
 32:                     LA21 x---|4           17|---x !ROMEN                   
 33:                     LA20 x---|5           16|---x !ROM                     
 34:                     LA19 x---|6           15|---x !M16E                    
 35:                     LA18 x---|7           14|---x !M32                     
 36:                     LA17 x---|8           13|---x !RFSH                    
 37:                     SA16 x---|9           12|---x !ROMIOE                  
 38:                      GND x---|10          11|---x !MRDC                    
 39:                              |______________|
 40:
 41:*/
 42:
 43:
 44:PIN 1 = BALE ;
 45:PIN 2 = LA23 ;
 46:PIN 3 = LA22 ;
 47:PIN 4 = LA21 ;
 48:PIN 5 = LA20 ;
 49:PIN 6 = LA19 ;
 50:PIN 7 = LA18 ;
 51:PIN 8 = LA17 ;
 52:PIN 9 = SA16 ;
 53:PIN 11 = !MRDC ;

LISTING FOR LOGIC DESCRIPTION FILE: D4-SROMA.pld                     Page 2

CUPL(WM): Universal Compiler for Programmable Logic
Version 5.0a Serial# MW-10400000
Copyright (c) 1983, 1998 Logical Devices, Inc.
Created Sat May 16 17:10:37 2026

 54:PIN 12 = !ROMIOE ;
 55:PIN 13 = !RFSH ;
 56:PIN 14 = !M32 ;
 57:PIN 15 = !M16E ;
 58:PIN 16 = !ROM ;
 59:PIN 17 = !ROMEN ;
 60:PIN 18 = !LOWEN ;
 61:PIN 19 = !ROM20E ;
 62:                      
 63:         
 64:
 65: 
 66:M16E =
 67:  !LA23 & !LA22 & !LA21 & !LA20 & LA19 & LA18 & LA17        /* 00E0000h-00FFFFFh */
 68: # LA23 &  LA22 &  LA21 &  LA20 & LA19 & LA18 & LA17        /* 0FE0000h-0FFFFFFh */
 69: # M32;  
 70:     
 71:  
 72:ROM =
 73:  !LA23 & !LA22 & !LA21 & !LA20 & LA19 & LA18 & LA17 & BALE /* 00E0000h-00FFFFFh */
 74:#  LA23 &  LA22 &  LA21 &  LA20 & LA19 & LA18 & LA17 & BALE /* 0FE0000h-0FFFFFFh */
 75:# !LA23 & !LA22 & !LA21 & !LA20 & LA19 & LA18 & LA17 & ROM  /* DEGLITCH */
 76:#  LA23 &  LA22 &  LA21 &  LA20 & LA19 & LA18 & LA17 & ROM  /* DEGLITCH */
 77:# !BALE &  ROM;                                             /* LATCH TERM */
 78:                                       
 79: 
 80:ROMIOE =
 81:  ROM  & SA16  & MRDC;                                      /* 00F0000h-00FFFFFh  */
 82:                                                            /* 0FF0000h-0FFFFFFh */
 83:                                                                                     
 84: 
 85:ROM20E = ROM  & !SA16  & MRDC;                              /* 00E0000h-00EFFFFh  */
 86:                                                            /* 0FE0000h-0FEFFFFh */
 87:  
 88:ROMEN =
 89:  ROM  & MRDC;                                              /* BUFFER ENABLE */
 90:                                     
 91: 
 92:LOWEN =
 93:  !LA23 & !LA22 & !LA21 & !LA20 & BALE                      /* BOTTOM ONE MEGABYTE AND BALE */
 94:# !LA23 & !LA22 & !LA21 & !LA20 & LOWEN                     /* DEGLITCH TERM */
 95:# !BALE & LOWEN                                             /* LATCH TERM */
 96:# RFSH;                                                     /* AND REFRESH */
 97:                                                  
 98:
 99:
100:
101:



Jedec Fuse Checksum       (57a4)
Jedec Transmit Checksum   (27ca)
