  9:Device          p22v10;
 10:
 11:/* 16/05/2026 V1 Initial version converted from PALASM format in COMPAQ design doc         */
 12:/*                                                                                         */
 13:/*******************************************************************************************/
 14:/*                                                                                         */
 15:/*******************************************************************************************/
 16:/*
 17:DESCRIPTION
 18:This PAL implements some of the bus controller state machine logic.
 19:REV B adjusts the sampling time of the IO16* line by adding state Tl0 to the 
 20:startup of T41. If the CX16* (IO16) line comes in after T00 then we shift 
 21:to T41 instead of T40. REV B also tightens up the response from ADS* to ALE by 
 22:one clock by shifting directly to ALE from MYCYC during the initial bus 
 23:transaction. State TSO is still used between transactions.
 24:*/
 25:
 26:/* Pin Map 
 27:                               ______________
 28:                              |   D4_STATB   |
 29:                    CLK16 x---|1           24|---x Vcc                      
 30:                   !MYCYC x---|2           23|---x !RST                     
 31:                   !CLAST x---|3           22|---x !ALE                     
 32:                    !CX16 x---|4           21|---x CK8                      
 33:                     LMIO x---|5           20|---x !T41                     
 34:                   !LNOWS x---|6           19|---x !T40                     
 35:                   !BWAIT x---|7           18|---x !WDEN                    
 36:                     !M16 x---|8           17|---x !CMD                     
 37:                      T00 x---|9           16|---x !TS0                     
 38:                      T01 x---|10          15|---x !BRDY                    
 39:                      T10 x---|11          14|---x T31                      
 40:                      GND x---|12          13|---x !OE                      
 41:                              |______________|
 42:
 43:*/
 44:
 45:/*******************************************************************************************/
 46:
 47:/* Inputs Note GAL20V10 Pin 23 and 14 are also inputs. Only Pins 15-22 can be Outputs */
 48:Pin  1 = CLK16;
 49:Pin  2 = !MYCYC;
 50:Pin  3 = !CLAST;
 51:Pin  4 = !CX16;
 52:Pin  5 = LMIO;
 53:Pin  6 = !LNOWS;

