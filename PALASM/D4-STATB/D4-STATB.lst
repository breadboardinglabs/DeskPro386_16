 54:Pin  7 = !BWAIT;
 55:Pin  8 = !M16;
 56:Pin  9 = T00;
 57:Pin 10 = T01;
 58:Pin 11 = T10;
 59:Pin 13 = !OE;
 60:Pin 14 = T31;
 61:Pin 23 = !RST;
 62:
 63:/* Outputs Note GAL20V10 Pin 23 and 14 are also inputs. Only Pins 15-22 can be Outputs */
 64:
 65:Pin 15 = !BRDY;
 66:Pin 16 = !TS0;
 67:Pin 17 = !CMD;
 68:Pin 18 = !WDEN;
 69:Pin 19 = !T40;
 70:Pin 20 = !T41;
 71:Pin 21 = CK8;
 72:Pin 22 = !ALE;
 73:
 74:
 75:/* The following functions are clocked by CLK16* */
 76:
 77:TS0.d =
 78:    !RST & !CLAST &  T41 & !BWAIT                  /* START NEXT CYCLE WHEN DONE WITH */
 79:  # !RST & !CLAST & !CK8 &  LNOWS & CMD            /* PREV CYCLE AND MORE IN GROUP */ 
 80:  # !RST &  CLAST &  T41 & !BWAIT & MYCYC          /* START NEXT CYCLE WHEN DONE WITH */
 81:  # !RST &  CLAST & !CK8 &  LNOWS & CMD & MYCYC;  /* PREV CYCLE AND NEW CPU REQUEST IS PENDING */
 82:TS0.oe = OE;
 83:
 84:CMD.d =
 85:    !RST &  CMD & !LNOWS & !T41            /* HOLDS UNTIL ENDED BY END OF */
 86:  # !RST &  CMD & !LNOWS &  BWAIT          /* WAIT */
 87:  # !RST &  CMD &  CK8                     /* OR NOWS AND CK8 LOW */
 88:  # !RST & !CMD &  ALE & M16 & LMIO       /* STARTS AFTER ALE UNLESS */
 89:  # !RST & !CMD &  T00;                    /* CMDLY (THEN AFTER T00) */
 90:CMD.oe = OE;
 91:  
 92:WDEN.d =
 93:    !RST &  TS0                               /* STARTS WHEN ALE DOES AFTER TSO */
 94:  # !RST & !TS0 & !ALE & !CMD & !T00 & MYCYC  /* OR WHEN CPU SENDS NEW START REQUEST */
 95:  # !RST &  ALE                               /* CONTINUES THROUGH T00 */
 96:  # !RST &  T00                               /* AND T01 */
 97:  # !RST &  CMD;                              /* UNTIL AFTER CMD GOES AWAY */
 98:WDEN.oe = OE;
 99:  
100:T41.d =
101:    !RST &  T40                           /* STARTS WHEN T40 ENDS */
102:  # !RST &  T10 & CX16 & !LNOWS & CMD     /* OR WHEN T10 ENDS ON 1/0 CYCLE */
103:  # !RST &  T41 & BWAIT;                  /* AND HOLDS TILL WAIT IS GONE */
104:T41.oe = OE;
105:  
106:
107:T40.d =

LISTING FOR LOGIC DESCRIPTION FILE: D4-STATB.pld                     Page 3

