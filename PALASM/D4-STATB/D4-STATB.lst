108:    T01 & CX16 & !LNOWS & !RST            /* STARTS AFTER T01 IF 16 BIT */
109:  # T31 &        !LNOWS & !RST;            /* OR AFTER T31 OTHERWISE */
110:T40.oe = OE;
111:  
112:!CK8.d =
113:    !RST & TS0                               /* SET TO LOW DURING ALE AFTER TS0 */
114:  # !RST & !TS0 & !ALE & !CMD & !T00 & MYCYC /* WHEN CPU SENDS NEW START REQUEST */
115:  # CK8;                                     /* OTHERWISE, DIVIDE BY TWO */
116:CK8.oe = OE;
117:  
118:BRDY.d =
119:    !RST & CLAST & T41 & !BWAIT              /* START NEXT CYCLE WHEN DONE */
120:  # !RST & CLAST & !CK8 & LNOWS & CMD;      /* WITH PREV CYCLE AND NO MORE IN GROUP */
121:BRDY.oe = OE;
122: 
123:ALE.d =
124:    !RST & TS0                                 /* ALE FOLLOWS TSO FOR INTERNAL LISE */
125:  # !RST & !TS0 & !ALE & !CMD & !T00 & MYCYC;  /* WHEN CPU SENDS NEW START REQUEST */
126:ALE.oe = OE;
127:  
128:/* FUNCTION TABLE
129:CLK16 /OE /RST /M16 LMIO /LNOWS /BWAIT /CLAST /CX16 /MYCYC TS0 ALE T00 
130:T01 T10 T31 T40 T41 /BRDY /CMD /WDEN CK8
131:;        / / /   / 
132:;C       L B C /    M                  /   / 
133:;L   /   L N W L C  Y                  B / W 
134:;K / R M M 0 A A X  C T A T T T T T T  R C D C
135:;1 O S 1 I W I S 1  Y S L 0 0 1 3 4 4  D M E K
136:;6 E T 6 O S T T 6  C 0 E 0 1 0 1 0 1  Y D N 8
137:;I I I I I I I I I  I O O I I I I O O  O O O O 
138:---------------------------------------------------~----------------------
139:*/
140:
