 54:PIN 1 = CALE ;
 55:PIN 2 = ALE ;
 56:PIN 3 = !BE3 ;
 57:PIN 4 = !BE2 ;
 58:PIN 5 = !BE1 ;
 59:PIN 6 = !BE0 ;
 60:PIN 7 = LM_IO ;
 61:PIN 8 = T00 ;
 62:PIN 9 = T10 ;
 63:PIN 10 = !LM16 ;
 64:PIN 11 = !IO16 ;
 65:PIN 13 = BHLDA ;
 66:PIN 14 = !CMD ;
 67:PIN 15 = !CLAST ;
 68:PIN 16 = !CLSTD ;
 69:PIN 17 = A1 ;
 70:PIN 18 = A0 ;
 71:PIN 19 = !BHE ;
 72:PIN 20 = !ALST ;
 73:PIN 21 = !CX16 ;
 74:PIN 22 = !DCMD ;
 75:PIN 23 = !RST ;/* The following 4 outputs are clocked by ALE, output only when /HLDA is true */
 76:
 77:                      
 78:                 
 79:
 80:  
 81:!A1.D =
 82:        !RST & !BE3 & !BE2 
 83:      # !RST & !A1 & !A0  & !CX16 & !CLAST 
 84:      # !RST & BE1 & CLAST;         
 85:
 86:A1.oe = !BHLDA;
 87:  
 88:!A0.D =
 89:        !RST & BE0 & CLAST         
 90:      # !RST & BE2 & !BE1 & CLAST   
 91:      # !RST & BE2 & A0 & !CLAST    
 92:      # !RST & CX16 & !CLAST;       
 93:A0.oe = !BHLDA;
 94:
 95:  
 96:BHE.D =
 97:        !RST & !A0 & !CX16 & !CLAST 
 98:      # !RST & BE1 & CLAST         
 99:      # !RST & BE3; 
100:BHE.oe = !BHLDA;
101:
102: 
103:ALST.D =
104:        !RST & !CX16  & !BE2   & !CLAST 
105:      # !RST & !BE2   & !BE0   & CLAST  
106:      # !RST & !BE3   & !BE1   & CLAST  
107:      # !RST & !BE3   & A0     & !CLAST 

