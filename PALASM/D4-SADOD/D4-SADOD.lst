108:      # !RST & !CX16  & A1     & !A0  & !CLAST 
109:      # !RST & CX16   & !BE3   & !CLAST;        /* Cycle LAST PRESET input for internal F/F (Cleared by rising edge of ALE)  */
110:ALST.oe = !BHLDA;                                /* This is pulsed only once to set F/F and generate the NAB* signal */
111: 
112:
113: 
114:CLSTD =
115:         ALST  &  T00                            /* Active during the last cycle of set */
116:      #  LM_IO  & LM16 & T00 & !BE2 
117:      #  LM_IO  & LM16 & T00 & A1  
118:      # !LM_IO & IO16 & T10 & !BE2 & !ALST 
119:      # !LM_IO & IO16 & T10 & A1  & !ALST  
120:      #  RST;                                    /* and during RESET */
121:CLSTD.oe = 'b'1;                               
122: 
123:CLAST =
124:         ALST   & T00                             /* Active during the last cycle of set */
125:      #  LM_IO  & LM16 & T00 & !BE2 
126:      #  LM_IO  & LM16 & T00 & A1  
127:      # !LM_IO & IO16 & T10 & !BE2 & !ALST 
128:      # !LM_IO & IO16 & T10 & A1 & !ALST   
129:      #  RST                                      /* and during RESET */
130:      #  CLAST  &  !ALE;                          /* HOLDS ACTIVE TILL ALE */
131:CLAST.oe = 'b'1;                      
132:  
133:CX16 = 
134:  !RST &  LM_IO &  T00 & LM16  /* CPU MEM OP */
135:# !RST & !LM_IO &  T10 & IO16  /* CPU I/O OP */                  
136:# !RST & !ALE          & CX16; /* CPU HOLD */
137:CX16.oe = 'b'1;            
138: 
139:DCMD = CMD; /*  DELAYED COMMAND */
140:DCMD.oe = 'b'1;                                 
