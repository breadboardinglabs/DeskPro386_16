===============================================================================
                            Expanded Product Terms
===============================================================================

BHE =>
    DAEN1 & XA0
  # AEN2

BHE.oe  =>
    DAEN

COPYEN =>
    BHE & !DAEN & !LM16 & MWTC & XA0
  # BHE & !DAEN & !IO16 & IOWX & XA0
  # BHE & !DAEN & !LM16 & MRDC & XA0
  # BHE & !DAEN & !IO16 & IORC & XA0
  # COPYHL & DAEN1 & LM16 & MRDC & XA0
  # DAEN1 & IORC & LM16 & XA0

COPYHL =>
    BHE & !DAEN & !LM16 & MWTC & XA0
  # BHE & !DAEN & !IO16 & IOWX & XA0
  # DAEN1 & LM16 & MRDC & XA0
  # COPYEN & COPYHL

DAEN =>
    DAEN1 & HLDA
  # AEN2 & HLDA

DAEN2 =>
    AEN2 & HLDA

LM16.d  =>
    M16

!XA0 =>
    AEN2

XA0.oe  =>
    AEN2 & HLDA

COPYEN.oe  =>
    1 

COPYHL.oe  =>
    1 

DAEN.oe  =>
    1 

DAEN2.oe  =>
    1 

HLDA.oe  =>
    0 


