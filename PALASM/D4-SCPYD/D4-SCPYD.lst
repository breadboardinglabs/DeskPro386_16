 54:PIN 6 = !IORC ;
 55:PIN 7 = !DAEN1 ;
 56:PIN 8 = AEN2 ;
 57:PIN 9 = !M16 ;
 58:/* PIN 9 = BALE ; */
 59:/* PIN 11 = !HLDA ; */
 60:PIN 11 = !oe ;
 61:PIN 12 = !DAEN2 ;
 62:PIN 13 = !COPYEN ;
 63:PIN 14 = !COPYHL ;
 64:PIN 15 = !DAEN ;
 65:PIN 16 = !BHE ;
 66:PIN 17 = XA0 ;
 67:PIN 18 = !LM16 ;
 68:PIN 19 = !HLDA ;
 69:               
 70:            
 71:
 72:  
 73:COPYEN =
 74:  !DAEN  & BHE     & XA0  & !LM16 & MWTC  /* CPU write MEM */
 75:# !DAEN  & BHE     & XA0  & !IO16 & IOWX  /* CPU write I/O */
 76:# !DAEN  & BHE     & XA0  & !LM16 & MRDC  /* CPU read MEM */
 77:# !DAEN  & BHE     & XA0  & !IO16 & IORC  /* CPU read I/O */
 78:#  DAEN1 & COPYHL  & XA0  &  LM16 & MRDC  /* DMA byte mem read high of 16 */
 79:#  DAEN1           & XA0  &  LM16 & IORC; /* DMA byte mem write high of 16 */
 80:            
 81:  
 82:COPYHL = 
 83:  !DAEN  & BHE  & XA0  & !LM16  & MWTC    /* mem write */
 84:# !DAEN  & BHE  & XA0  & !IO16  & IOWX    /* I/O write */
 85:#  DAEN1        & XA0  &  LM16  & MRDC    /* DMA byte mem read high of 16 */
 86:#  COPYHL  & COPYEN;                      /*  Short holdover for write */
 87:                      
 88:    
 89:DAEN =
 90:  DAEN1  & HLDA 
 91:# AEN2   & HLDA;                          /* If word type of DMA, enable out  */
 92: 
 93:        
 94:                                              
 95:XA0.OE = AEN2 & HLDA;
 96:     
 97:!XA0 = AEN2;                              /*  (Pin is low for word DMA) */
 98:
 99:/* If DMA, enable output */
100:BHE.OE = DAEN ;
101:   
102:BHE =
103:  XA0  & DAEN1                             /*  If byte type, is inverted XA0 */
104:# AEN2;                                    /* If word type, is active */
105:                           
106:
107:LM16.d = M16;                              /* use BALE to latch M16 to avoid unstable output error on LM16 in simulation */

