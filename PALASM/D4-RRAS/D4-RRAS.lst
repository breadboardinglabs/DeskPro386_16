 19:/* Pin Map 
 20:                               ______________
 21:                              |   D4-RRAS    |
 22:                      A31 x---|1           20|---x Vcc                      
 23:                      A23 x---|2           19|---x !RS1                     
 24:                      A22 x---|3           18|---x !ROM                     
 25:                      A21 x---|4           17|---x !PARWR                   
 26:                      A20 x---|5           16|---x !PARRD                   
 27:                      A19 x---|6           15|---x !WE0                     
 28:                      A18 x---|7           14|---x !MRD                     
 29:                      A17 x---|8           13|---x !MWE                     
 30:                     FA20 x---|9           12|---x !RS0                     
 31:                      GND x---|10          11|---x !RFSH                    
 32:                              |______________|
 33:
 34:*/
 35:
 36:
 37:PIN 1 = A31 ;
 38:PIN 2 = A23 ;
 39:PIN 3 = A22 ;
 40:PIN 4 = A21 ;
 41:PIN 5 = A20 ;
 42:PIN 6 = A19 ;
 43:PIN 7 = A18 ;
 44:PIN 8 = A17 ;
 45:PIN 9 = FA20 ;
 46:PIN 11 = !RFSH ;
 47:PIN 12 = !RS0 ;
 48:PIN 13 = !MWE ;
 49:PIN 14 = !MRD ;
 50:PIN 15 = !WE0 ;
 51:PIN 16 = !PARRD ;
 52:PIN 17 = !PARWR ;
 53:PIN 18 = !ROM ;

