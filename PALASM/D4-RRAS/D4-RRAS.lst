 59: 
 60:RS0 =
 61:  !A31 & !A23 & !A22 & !A21 & !A20  & !A19                 /* 00000000H 512K */
 62:# !A31 & !A23 & !A22 & !A21 & !FA20 & !A19                 /* 00100000H 512K */
 63:# !A31 & !A23 & !A22 & !A21 & !A20  &  A19 & !A18 & !A17   /* 00080000H 128K */
 64:# !A31 & !A23 & !A22 & !A21 & !A20  &  A19 &  A18 &  A17   /* 000E0000H 128K */
 65:# !A31 &  A23 &  A22 &  A21 &  A20                         /* 00F00000H 1024K */
 66:#  RFSH;                                                   /* REFRESH */
 67:                                                  
 68: 
 69:RS1 =
 70: !A31 & !A23 & !A22 & !A21 & A20 & FA20                    /* 00100000H 1024K */
 71:# RFSH;                                                    /* REFRESH */
 72:                                                 
 73: 
 74:PARWR =
 75: MWE & A31 & A23 & A22 & !A21 & !A20 & !A19 & !A18 & !A17; /* 80COOOOOH 128K */
 76:      
 77: 
 78:PARRD =
 79: MRD & A31 & A23 & A22 & !A21 & !A20 & !A19 & !A18 & !A17; /* 80C00000H 128K */
 80:      
 81: 
 82:WE0 =
 83:  MWE & !A31 & !A23 & !A22 & !A21 & !A19                                /* 00000000H 512K */
 84:# MWE & !A31 & !A23 & !A22 & !A21 & !A20 &  A19  & !A18 & !A17          /* 00080000H 128K */
 85:# MWE & !A31 & !A23 & !A22 & !A21 & !A20 &  A19  &  A18 &  A17  & !ROM  /* 000E0000H 128K */
 86:# MWE & !A31 &  A23 &  A22 &  A21 &  A20 & !A19  &  A18                 /* 00F40000H 256K */
 87:# MWE & !A31 &  A23 &  A22 &  A21 &  A20 &  A19  & !A18                 /* 00FB0000H 256K */
 88:# MWE & !A31 &  A23 &  A22 &  A21 &  A20 &  A19  &  A18 & !A17          /* 00FC0000H 128K */
 89:# MWE & !A31 &  A23 &  A22 &  A21 &  A20 &  A19  &  A18 &  A17  & !ROM; /* 00FE0000H 128K */
