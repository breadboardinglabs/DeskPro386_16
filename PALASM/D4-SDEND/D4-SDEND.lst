 54:PIN 13 = !B0EN ;
 55:PIN 14 = !B1EN ;
 56:PIN 15 = !B2EN ;
 57:PIN 16 = !INTA ;
 58:PIN 17 = !MWTC ;
 59:PIN 18 = !MRDC ;
 60:PIN 19 = !B3EN ;
 61:
 62:                        
 63:            
 64:BDIRRD.OE = TST ;
 65:   
 66:BDIRRD = !MRDC & !WDEN;            /* OTHER WRITE TO LOCAL MEM */
 67:                
 68:
 69:B0EN.OE = TST ;
 70:   
 71:B0EN =
 72:  !A1 & !A0 & MWTC & !WDEN         /* OTHER WRITE TO LOCAL MEM */
 73:# !A1 & !A0 & MRDC & !WDEN & M32   /* OTHER READ FROM LOCAL MEM */
 74:# !A1 & !A0 & LD_C & LW_R & WDEN;  /* CPU WRITE TO BUS */
 75:    
 76:
 77:B1EN.OE = TST ;
 78:   
 79:B1EN =
 80:  !A1 & BHE & MWTC & !WDEN         /* OTHER WRITE TO LOCAL MEM */
 81:# !A1 & BHE & MRDC & !WDEN & M32   /* OTHER READ FROM LOCAL MEM */
 82:# !A1 & BHE & LD_C & LW_R & WDEN;  /* CPU WRITE TO BUS */
 83:    
 84:
 85:B2EN.OE = TST ;
 86:   
 87:B2EN =
 88:  A1 & !A0 & MWTC & !WDEN          /* OTHER WRITE TO LOCAL MEM */
 89:# A1 & !A0 & MRDC & !WDEN & M32    /* OTHER READ FROM LOCAL MEM */
 90:# A1 & !A0 & LD_C &  LW_R & WDEN;  /* CPU WRITE TO BUS */
 91:                    
 92:
 93:B3EN.OE = TST ;
 94:   
 95:B3EN =
 96:  A1 & BHE & MWTC & !WDEN          /* OTHER WRITE TO LOCAL MEM */
 97:# A1 & BHE & MRDC & !WDEN & M32    /* OTHER READ FROM LOCAL MEM */
 98:# A1 & BHE & LD_C & LW_R  & WDEN;  /* CPU WRITE TO BUS */
 99:                    
100:
101:INTA.OE = TST ;
102:   
103:INTA =
104:   CMD & !LM_IO & !LW_R & !LD_C;   /* CPU INTERRUPT ACK */
105:
106:
107:



