 54:PIN 14 = !B1EN ;
 55:PIN 15 = !B2EN ;
 56:PIN 16 = !INTA ;
 57:PIN 17 = !MWTC ;
 58:PIN 18 = !MRDC ;
 59:PIN 19 = !B3EN ;
 60:
 61:                        
 62:            
 63:BDIRRD.OE = !TST ;
 64:   
 65:BDIRRD = !MRDC & !WDEN;            /* OTHER WRITE TO LOCAL MEM */
 66:                
 67:
 68:B0EN.OE = !TST ;
 69:   
 70:B0EN =
 71:  !A1 & !A0 & MWTC & !WDEN         /* OTHER WRITE TO LOCAL MEM */
 72:# !A1 & !A0 & MRDC & !WDEN & M32   /* OTHER READ FROM LOCAL MEM */
 73:# !A1 & !A0 & LD_C & LW_R & WDEN;  /* CPU WRITE TO BUS */
 74:    
 75:
 76:B1EN.OE = !TST ;
 77:   
 78:B1EN =
 79:  !A1 & BHE & MWTC & !WDEN         /* OTHER WRITE TO LOCAL MEM */
 80:# !A1 & BHE & MRDC & !WDEN & M32   /* OTHER READ FROM LOCAL MEM */
 81:# !A1 & BHE & LD_C & LW_R & WDEN;  /* CPU WRITE TO BUS */
 82:    
 83:
 84:B2EN.OE = !TST ;
 85:   
 86:B2EN =
 87:  A1 & !A0 & MWTC & !WDEN          /* OTHER WRITE TO LOCAL MEM */
 88:# A1 & !A0 & MRDC & !WDEN & M32    /* OTHER READ FROM LOCAL MEM */
 89:# A1 & !A0 & LD_C &  LW_R & WDEN;  /* CPU WRITE TO BUS */
 90:                    
 91:
 92:B3EN.OE = !TST ;
 93:   
 94:B3EN =
 95:  A1 & BHE & MWTC & !WDEN          /* OTHER WRITE TO LOCAL MEM */
 96:# A1 & BHE & MRDC & !WDEN & M32    /* OTHER READ FROM LOCAL MEM */
 97:# A1 & BHE & LD_C & LW_R  & WDEN;  /* CPU WRITE TO BUS */
 98:                    
 99:
100:INTA.OE = !TST ;
101:   
102:INTA =
103:   CMD & !LM_IO & !LW_R & !LD_C;   /* CPU INTERRUPT ACK */
104:
105:
106:



