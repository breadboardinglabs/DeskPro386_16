  1:Name            D4-SDEND DataBuffer enable logic;
  2:PartNo          109390-001;
  3:Revision        01;
  4:Date            16/5/26;
  5:Designer        Dave Henry;
  6:Company         Breadboarding Labs;
  7:Location        None;
  8:Assembly        None;
  9:Device          g16v8;
 10:
 11:/* 16/05/2026 V1 Initial version converted from PALASM format in COMPAQ design doc         */
 12:/*                                                                                         */
 13:/*******************************************************************************************/
 14:/*                                                                                         */
 15:/*******************************************************************************************/
 16:/*
 17:DESCRIPTION
 18:This PAL developes the control signal to enable the data buffers on the system
 19:board.
 20:Rev A ensures turnon of the buffer enables for mem write after the direction 
 21:is active by leaving the buffer turned around during the entire write cycle.
 22:Rev D is for use with D3PE D4-processor board (with 387).
 23:*/
 24:/* Pin Map 
 25:                               ______________
 26:                              |   D4-SDEND   |
 27:                       A1 x---|1           20|---x Vcc                      
 28:                       A0 x---|2           19|---x !B3EN                    
 29:                     !BHE x---|3           18|---x !MRDC                    
 30:                     !CMD x---|4           17|---x !MWTC                    
 31:                     !M32 x---|5           16|---x !INTA                    
 32:                    !WDEN x---|6           15|---x !B2EN                    
 33:                     LW_R x---|7           14|---x !B1EN                    
 34:                     LD_C x---|8           13|---x !B0EN                    
 35:                    LM_IO x---|9           12|---x !BDIRRD                  
 36:                      GND x---|10          11|---x !TST                     
 37:                              |______________|
 38:
 39:*/
 40:
 41:
 42:PIN 1 = A1 ;
 43:PIN 2 = A0 ;
 44:PIN 3 = !BHE ;
 45:PIN 4 = !CMD ;
 46:PIN 5 = !M32 ;
 47:PIN 6 = !WDEN ;
 48:PIN 7 = LW_R ;
 49:PIN 8 = LD_C ;
 50:PIN 9 = LM_IO ;
 51:PIN 11 = !TST ;
 52:PIN 12 = !BDIRRD ;
 53:PIN 13 = !B0EN ;

