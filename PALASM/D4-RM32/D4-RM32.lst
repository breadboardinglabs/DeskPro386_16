109:+     /A31* /A23* /A22* /A21* /A20* /A19* A18*      512K ;040000-07FFFF 256K
110:+     /A31* /A23* /A22* /A21* /A20* A19* /A18* /A17* 640K ;080000-09FFFF 128K
111:+     /A31* /A23* /A22* /A21* /A20* A19* A18* A17* ROM  ;0E0000-0FFFFF 128K
112:+     /A31* A23* A22* A21* A20* /A19* A18*     /512K ;F40000-F7FFFF 256K
113:+     /A31* A23* A22* A21* A20* A19* /A18* /A17* /640K ;F80000-F9FFFF 128K
114:+     /A31* A23* A22* A21* A20* A19* /A18* A17       ;FA0000-FBFFFF 128K
115:+     /A31* A23* A22* A21* A20* A19* A18            ;FC0000-FFFFFF 256K
116:+     /A31* /A23* /A22* /A21* A20*                1M   ;100000-1FFFFF 1M
117:+     /A31* /A23* /A22* A21*                     2M   ;200000-3FFFFF 2M
118:+     /A31* /A23* A22* /A21*                     8M   ;400000-5FFFFF 2M
119:+     /A31* /A23* A22* A21*                     8M   ;600000-7FFFFF 2M
120:+     /A31* A23* /A22* /A21*                     8M   ;800000-9FFFFF 2M
121:+     A31*  A23* A22* /A21* /A20* /A19* /A18* /A17       ;DIAG 80C0000h 128K
122:
123:*/
