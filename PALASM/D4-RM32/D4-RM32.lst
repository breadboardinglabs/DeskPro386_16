 19:/* Pin Map 
 20:
 21:                               ______________
 22:                              |   D4-RM32    |
 23:                      A31 x---|1           20|---x Vcc                      
 24:                      A23 x---|2           19|---x !M32C                    
 25:                      A22 x---|3           18|---x !8M                      
 26:                      A21 x---|4           17|---x !1M                      
 27:                      A20 x---|5           16|---x !640K                    
 28:                      A19 x---|6           15|---x !512K                    
 29:                      A18 x---|7           14|---x !ROM                     
 30:                      A17 x---|8           13|---x !M32B                    
 31:                     FA20 x---|9           12|---x !M32A                    
 32:                      GND x---|10          11|---x !2M                      
 33:                              |______________|
 34:
 35:*/
 36:
 37:PIN 1 = A31 ;
 38:PIN 2 = A23 ;
 39:PIN 3 = A22 ;
 40:PIN 4 = A21 ;
 41:PIN 5 = A20 ;
 42:PIN 6 = A19 ;
 43:PIN 7 = A18 ;
 44:PIN 8 = A17 ;
 45:PIN 9 = FA20 ;
 46:PIN 11 = !2M ;
 47:PIN 12 = !M32A ;
 48:PIN 13 = !M32B ;
 49:PIN 14 = !ROM ;
 50:PIN 15 = !512K ;
 51:PIN 16 = !640K ;
 52:PIN 17 = !1M ;
 53:PIN 18 = !8M ;

